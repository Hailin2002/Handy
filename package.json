{
  "name": "speak-app",
  "private": true,
  "version": "0.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "check:translations": "node scripts/check-translations.ts",
    "check:log-hygiene": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify/check-log-hygiene.ps1",
    "check": "node scripts/check-translations.ts && node scripts/verify/check-bindings-sync.ts && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify/check-log-hygiene.ps1",
    "postinstall": "bun scripts/check-nix-deps.ts",
    "check:bindings": "node scripts/verify/check-bindings-sync.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-fs": "~2.4.5",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "i18next": "^25.10.10",
    "immer": "^11.1.18",
    "lucide-react": "^0.542.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "prettier": "^3.9.6",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
