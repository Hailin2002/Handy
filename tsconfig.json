{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    /* Was true. Turning it off surfaced nothing, so the dependency type
       surface is actually consistent — and any future conflict between the
       Tauri plugin packages now shows up instead of being hidden. */
    "skipLibCheck": false,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path Aliases (baseUrl removed in TypeScript 7; paths resolve relative
       to this file) */
    "paths": {
      "@/*": ["./src/*"],
      "@/bindings": ["./src/bindings.ts"]
    },

    /* Linting */
    "strict": true,
    /* noUnusedLocals stays off deliberately: src/bindings.ts is generated by
       tauri-specta and declares a TAURI_CHANNEL it does not use, so tsc would
       fail on a file nobody can edit. Unused locals in authored code are
       covered by @typescript-eslint/no-unused-vars, which ignores the
       generated file. */
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
